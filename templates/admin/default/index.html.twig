{% extends 'base.html.twig' %}

{% block title %}Espace Admin{% endblock %}

{% block body %}
    <section class="container mt-5">
        <div class="card shadow p-4">
            <h2 class="text-center mb-4">Interface d'administration</h2>
            <p class="text-center">Bienvenue {{ app.user ? app.user.email : 'invité' }} !</p>

            <hr>

            <div class="text-center mt-4">
                <a href="{{ path('app_logout') }}" class="btn btn-danger">Se déconnecter</a>
            </div>
        </div>
    </section>
{% endblock %}
