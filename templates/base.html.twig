<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <header>
        <img src="{{ asset('images/nologo.svg') }}" alt="Logo" width="100">
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('app_login') }}">Municipal Library</a>

                <div class="d-flex">
                    <a href="{{ path('app_toggle_theme') }}" class="btn btn-outline-secondary">
                        🌗 Mode {{ app.request.cookies.get('myapp_dark_mode') == 'true' ? 'clair' : 'sombre' }}
                    </a>
                </div>
            </div>
        </nav>

    </header>
    <body class="{{ app.request.cookies.get('myapp_dark_mode') == 'true' ? 'dark-mode' : 'light-mode' }}">
        {% block body %}{% endblock %}
    </body>

</html>
